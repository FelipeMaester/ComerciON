# ---- Postgres ----
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
POSTGRES_PORT=5432

# ---- Backup do banco (scripts/backup-db.sh) ----
# Onde os dumps ficam. Em produção aponte para um disco DIFERENTE do que
# guarda o banco — backup na mesma máquina não protege contra perder a máquina.
BACKUP_DIR=./backups
# Dumps mais antigos que isto são apagados...
BACKUP_RETENTION_DAYS=14
# ...exceto os N mais recentes, que ficam sempre. Protege o caso do backup ter
# parado de rodar há semanas: a limpeza apagaria justamente os últimos que
# restaram.
BACKUP_KEEP_MINIMUM=3

# ---- Cópia do backup FORA do servidor ----
# Backup guardado ao lado do banco protege contra "apaguei a tabela errada", e
# contra mais nada. Não protege contra o disco morrer, contra o provedor sumir
# com a máquina, nem contra ransomware — que é exatamente quando alguém precisa
# do backup.
#
# Como ligar (uma vez, na sua máquina ou no servidor):
#   1. Instale o rclone:  curl https://rclone.org/install.sh | sudo bash
#   2. Rode 'rclone config' e crie um destino. Backblaze B2 é o mais barato
#      para isto; S3, Google Drive, OneDrive e dezenas de outros servem.
#      Use uma chave RESTRITA ao bucket do backup, nunca a master key.
#   3. Copie o rclone.conf gerado para a pasta ./rclone do projeto (ela é
#      ignorada pelo git — contém as credenciais do seu armazenamento).
#   4. Preencha BACKUP_REMOTE abaixo com "nome-do-destino:bucket".
#   5. PROVE que funciona antes de precisar:
#        ./scripts/verificar-backup-remoto.sh
#      Ele grava, lista, lê de volta e compara byte a byte. Chave só de
#      leitura ou bucket errado aparecem ali, não no dia do desastre.
#
# Para restaurar quando a máquina não existe mais:
#   ./scripts/restore-db.sh --do-remoto --into erp_ensaio --drop
#
# Quando está ligado e o envio FALHA, o script termina com erro e o backup
# local é preservado. De propósito: um aviso engolido aqui produziria a pior
# situação possível — achar que existe cópia fora do servidor quando não existe.
# BACKUP_REMOTE=b2:comercion-backups
BACKUP_REMOTE=

# Pasta que contém o rclone.conf. Só mude se o arquivo estiver em outro lugar.
# RCLONE_CONFIG_DIR=./rclone

# Apagar cópias remotas mais antigas que N dias. Vazio = nunca apaga lá fora,
# que é o padrão: armazenamento remoto é barato, e o estrago de uma limpeza mal
# configurada no ÚNICO backup fora do servidor não é.
BACKUP_REMOTE_RETENTION_DAYS=

# ---- API (apps/api) ----
API_PORT=3001
NODE_ENV=development
# Usado fora do docker-compose (localhost); dentro do compose a API monta a URL com os valores acima.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp

# JWT — gere segredos fortes em produção (ex: openssl rand -hex 64). Os dois
# precisam ser DIFERENTES entre si: com o mesmo valor, um token de acesso (15
# minutos) passa a valer como token de refresh (7 dias).
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Nome exibido nos apps autenticadores (Google Authenticator etc.) ao ativar 2FA
TOTP_ISSUER=ComercioERP

# Header usado para resolver o tenant quando o endereço não identifica a loja
TENANT_HEADER=x-tenant-slug

# ---- Uma loja por subdomínio ----
# Com isto configurado, oficina-do-ze.painel.minhaloja.com.br já identifica a
# loja: a tela de login para de pedir o "identificador da empresa", que é a
# parte que mais confunde quem entra pela primeira vez.
#
# É o domínio DEPOIS do nome da loja. O valor é conferido literalmente, não
# adivinhado contando pontos — endereço de outro domínio é recusado.
#
#   TENANT_BASE_DOMAIN=painel.minhaloja.com.br
#   → oficina.painel.minhaloja.com.br  resolve a loja "oficina"
#   → painel.minhaloja.com.br          não resolve nada (tela pede o nome)
#
# Precisa de DNS curinga (*.painel.minhaloja.com.br → IP do servidor). O
# certificado o Caddy emite sozinho, por endereço, na primeira visita.
#
# Vazio = desligado, e tudo continua como antes (só o header resolve).
#
# CUIDADO ao apontar para o domínio raiz (minhaloja.com.br): aí uma loja
# chamada "api" viraria api.minhaloja.com.br e brigaria com o endereço da
# própria API. Use um nível a mais, como no exemplo.
TENANT_BASE_DOMAIN=

# O painel precisa da MESMA informação para saber que não deve pedir o
# identificador. É embutida no bundle em tempo de build, como a URL da API:
# trocar exige rebuild, não só reiniciar.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=

# Origem do painel. Precisa ser o endereço EXATO (não aceita "*"): a sessão vai
# em cookie, e o navegador recusa resposta com credencial vinda de origem
# curinga.
CORS_ORIGIN=http://localhost:3000

# Quantos proxies existem na frente da API. Vazio = nenhum (padrao).
#
# So preencha se a API estiver ATRAS de um proxy reverso (o compose de
# producao ja poe TRUST_PROXY=1, porque la o Caddy e a unica entrada).
#
# Por que importa: o limitador de requisicoes usa o IP do cliente como chave.
# Atras de um proxy sem esta variavel, a API enxerga o IP do PROXY em toda
# chamada, e o teto de 100 req/min deixa de ser por cliente e vira teto da
# plataforma inteira. Ligar sem proxy nenhum e o erro oposto: ai qualquer um
# forja o proprio IP e passa por cima do limite de login.
TRUST_PROXY=

# Teto de requisicoes por minuto, por cliente. Vazio = 100.
#
# Existe pelo mesmo motivo do LOGIN_RATE_LIMIT: a suite de testes faz o
# trabalho de uma tarde inteira em um minuto, do mesmo IP. Em producao, deixe
# vazio — o padrao e o que protege contra varredura.
GLOBAL_RATE_LIMIT=

# ---- Sessão em cookie ----
# O token de acesso e o de renovação viajam em cookies httpOnly emitidos pela
# API — o JavaScript da página não consegue lê-los, então um XSS não copia a
# sessão. Não há nada para configurar aqui, mas há UMA restrição de deploy:
#
#   O painel e a API precisam estar no MESMO domínio registrável.
#   painel.minhaloja.com.br + api.minhaloja.com.br  → funciona
#   painel.minhaloja.com.br + api.outrodominio.com  → NINGUÉM consegue entrar
#
# O cookie é marcado SameSite=Lax, e o navegador só o envia entre endereços que
# ele considera o mesmo site (o que vale é o domínio registrável, não o
# subdomínio). A falha é barulhenta — login que não entra —, não silenciosa.
#
# O atributo Secure é ligado sozinho quando NODE_ENV=production. Em
# desenvolvimento ele fica desligado, senão o navegador descartaria o cookie
# por não haver HTTPS.

# Modelo de linguagem — opcional e DESLIGADO por padrão. O único recurso que
# usa isso hoje é SUGGESTION_ENGINE=ai logo abaixo; com SUGGESTION_ENGINE=rules
# (o padrão) nada aqui é lido e o sistema roda sem nenhuma chave de API.
AI_PROVIDER=stub
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# Quem gera as sugestões da aba de Automações ("O que o sistema identificou
# sozinho"). São coisas independentes: dá pra ter a IA do chat ligada e as
# sugestões no motor gratuito, ou o contrário.
#
#   rules (padrão) — o próprio sistema analisa. Ele já calcula todos os
#     números (contas vencidas, estoque abaixo do mínimo, clientes inativos)
#     por SQL; o motor de regras compara com limiares e monta a sugestão
#     pronta. Custo zero por análise, resposta instantânea, funciona sem
#     nenhuma chave de API e sem internet.
#
#   ai — manda os MESMOS números agregados para o modelo configurado acima e
#     pede o texto de volta. Custa ~US$ 0,035 por análise. Vale se você quer
#     redação mais adaptada ao contexto de cada cliente.
SUGGESTION_ENGINE=rules
# SUGGESTION_ENGINE=ai

# Emissão fiscal (NF-e / NFC-e) — opcional. Sem nada configurado,
# FISCAL_PROVIDER cai em "stub": o fluxo inteiro funciona (emitir, cancelar,
# carta de correção, impressão), mas NÃO sai nota de verdade.
#
# Para emitir para valer com o Focus NFe:
#   1. Crie conta em focusnfe.com.br e cadastre a empresa (CNPJ, inscrição
#      estadual, endereço, regime tributário e certificado digital A1 ficam
#      no painel DELES, não aqui).
#   2. Pegue o token de API — são dois, um de homologação e um de produção.
#   3. Preencha abaixo. Deixe FOCUS_NFE_ENV=homologacao até validar tudo:
#      nota emitida em homologação não tem valor fiscal e não precisa ser
#      cancelada se der errado.
#   4. Cadastre NCM (e, se precisar, CFOP/CST) nos produtos — sem NCM a
#      emissão é barrada antes mesmo de chamar a SEFAZ, apontando o produto.
FISCAL_PROVIDER=stub
# FISCAL_PROVIDER=focusnfe
# FOCUS_NFE_TOKEN=
# FOCUS_NFE_ENV=homologacao   # troque para "producao" só quando for pra valer

# WhatsApp real (Fase E) — opcional. Sem nada configurado, WHATSAPP_PROVIDER
# cai em "stub" (só loga a mensagem, não envia nada de verdade). Pra ativar
# de verdade com o Sandbox gratuito do Twilio:
#   1. Crie uma conta em twilio.com e ative o Sandbox de WhatsApp
#      (Console → Messaging → Try it out → Send a WhatsApp message).
#   2. Exponha a API local publicamente (ex.: `ngrok http 3001`) e configure
#      a URL do ngrok + /api/whatsapp/webhook/twilio como webhook do Sandbox.
#   3. Preencha as variáveis abaixo e troque WHATSAPP_PROVIDER pra "twilio".
WHATSAPP_PROVIDER=stub
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# PUBLIC_API_URL=

# Teto de mensagens AUTOMÁTICAS por loja, por janela de 24h.
#
# Cada mensagem de WhatsApp é paga por unidade. Uma regra de automação com
# gatilho mal configurado envia sem ninguém no comando, e a primeira notícia
# disso costuma ser a fatura. Ao atingir o teto, os envios automáticos param e
# o motivo fica no log e no histórico da regra.
#
# A resposta do atendente no Inbox NÃO conta e nunca é bloqueada: lá tem uma
# pessoa clicando em enviar, uma de cada vez.
#
# 0 desliga o teto.
WHATSAPP_MAX_AUTOMATED_PER_DAY=300

# ---- Cobrança da assinatura (o SaaS cobrando as lojas) ----
# Sem nada configurado, BILLING_PROVIDER cai em "stub": o fluxo de assinatura
# funciona inteiro na tela e NENHUMA cobrança é emitida — o simulado aprova
# tudo na hora. É o único ponto em que ele se comporta diferente do real.
#
# Para cobrar de verdade com o Asaas:
#   1. Crie conta em asaas.com. O Sandbox é gratuito e separado da produção.
#   2. Pegue a chave de API. São duas, e elas NÃO se misturam: a de sandbox
#      (...) só funciona em api-sandbox.asaas.com, e a de produção
#      (...) só em api.asaas.com. Chave de um ambiente com URL do
#      outro dá erro de autenticação.
#   3. Cadastre o webhook no painel do Asaas apontando para
#      https://SEU_DOMINIO_DA_API/api/billing/webhook/asaas e defina ali um
#      token — o MESMO valor de ASAAS_WEBHOOK_TOKEN abaixo. Sem o webhook,
#      o sistema emite a cobrança e nunca fica sabendo que ela foi paga.
#   4. A loja precisa ter CNPJ cadastrado: o Asaas recusa cobrança sem
#      CPF/CNPJ do pagador.
#
# ASAAS_ENV=sandbox até validar tudo. Em "producao" as cobranças são reais e
# chegam de verdade para quem estiver cadastrado.
BILLING_PROVIDER=stub
# BILLING_PROVIDER=asaas
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# Token que você define ao criar o webhook no painel do Asaas. Sem ele a rota
# de webhook RECUSA tudo — de propósito: um webhook aberto deixaria qualquer
# um marcar a própria assinatura como paga.
# ASAAS_WEBHOOK_TOKEN=
# UNDEFINED deixa o cliente escolher entre boleto, PIX e cartão na fatura.
# BOLETO, PIX ou CREDIT_CARD forçam um só.
# ASAAS_BILLING_TYPE=UNDEFINED

# ---- E-mail ----
# Sem nada configurado, MAIL_PROVIDER cai em "stub": o fluxo inteiro funciona
# (inclusive "esqueci minha senha"), mas nada é enviado — a mensagem, com o
# link de redefinição, aparece no log da API. Em desenvolvimento isso basta.
#
# Para testar envio de verdade localmente, sem criar conta em lugar nenhum:
#   docker run -d --rm --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost, SMTP_PORT=1025, e abra http://localhost:8025
#
# Em produção NÃO use o SMTP do próprio servidor: quase todo provedor de VPS
# bloqueia a saída na porta 25, e um IP de nuvem sem reputação vai para spam.
# Use um serviço de envio (Brevo, Amazon SES, Resend, Zoho) e autentique o
# domínio com SPF e DKIM no DNS — sem isso o envio "funciona" e a mensagem não
# chega. Passo a passo no DEPLOY.md.
#
# Para conferir depois de configurar:
#   GET  /api/health/mail        → conexão e credenciais (200/503)
#   POST /api/health/mail/test   → manda um e-mail de teste (super-admin)
# SMTP_SECURE é deduzido da porta quando omitido (465 = TLS direto; 587 = STARTTLS).
MAIL_PROVIDER=stub
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Minha Loja <nao-responda@minhaloja.com.br>

# URL usada para montar o link de redefinição de senha no e-mail. Em produção
# precisa ser o endereço público real — se ficar em localhost, o e-mail sai com
# um link que só funciona na máquina que hospeda.
WEB_APP_URL=http://localhost:3000

# ---- Web (apps/web — painel admin) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

