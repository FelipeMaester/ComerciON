# ---- Postgres ----
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
POSTGRES_PORT=5432

# ---- Backup do banco (scripts/backup-db.sh) ----
# Onde os dumps ficam. Em produção aponte para um disco DIFERENTE do que
# guarda o banco — backup na mesma máquina não protege contra perder a máquina.
BACKUP_DIR=./backups
# Dumps mais antigos que isto são apagados...
BACKUP_RETENTION_DAYS=14
# ...exceto os N mais recentes, que ficam sempre. Protege o caso do backup ter
# parado de rodar há semanas: a limpeza apagaria justamente os últimos que
# restaram.
BACKUP_KEEP_MINIMUM=3

# ---- API (apps/api) ----
API_PORT=3001
NODE_ENV=development
# Usado fora do docker-compose (localhost); dentro do compose a API monta a URL com os valores acima.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp

# JWT — gere segredos fortes em produção (ex: openssl rand -hex 64). Os dois
# precisam ser DIFERENTES entre si: com o mesmo valor, um token de acesso (15
# minutos) passa a valer como token de refresh (7 dias).
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Nome exibido nos apps autenticadores (Google Authenticator etc.) ao ativar 2FA
TOTP_ISSUER=ComercioERP

# Header usado para resolver o tenant em desenvolvimento (em produção: subdomínio)
TENANT_HEADER=x-tenant-slug

# Origem do painel. Precisa ser o endereço EXATO (não aceita "*"): a sessão vai
# em cookie, e o navegador recusa resposta com credencial vinda de origem
# curinga.
CORS_ORIGIN=http://localhost:3000

# ---- Sessão em cookie ----
# O token de acesso e o de renovação viajam em cookies httpOnly emitidos pela
# API — o JavaScript da página não consegue lê-los, então um XSS não copia a
# sessão. Não há nada para configurar aqui, mas há UMA restrição de deploy:
#
#   O painel e a API precisam estar no MESMO domínio registrável.
#   painel.minhaloja.com.br + api.minhaloja.com.br  → funciona
#   painel.minhaloja.com.br + api.outrodominio.com  → NINGUÉM consegue entrar
#
# O cookie é marcado SameSite=Lax, e o navegador só o envia entre endereços que
# ele considera o mesmo site (o que vale é o domínio registrável, não o
# subdomínio). A falha é barulhenta — login que não entra —, não silenciosa.
#
# O atributo Secure é ligado sozinho quando NODE_ENV=production. Em
# desenvolvimento ele fica desligado, senão o navegador descartaria o cookie
# por não haver HTTPS.

# Modelo de linguagem — opcional e DESLIGADO por padrão. O único recurso que
# usa isso hoje é SUGGESTION_ENGINE=ai logo abaixo; com SUGGESTION_ENGINE=rules
# (o padrão) nada aqui é lido e o sistema roda sem nenhuma chave de API.
AI_PROVIDER=stub
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# Quem gera as sugestões da aba de Automações ("O que o sistema identificou
# sozinho"). São coisas independentes: dá pra ter a IA do chat ligada e as
# sugestões no motor gratuito, ou o contrário.
#
#   rules (padrão) — o próprio sistema analisa. Ele já calcula todos os
#     números (contas vencidas, estoque abaixo do mínimo, clientes inativos)
#     por SQL; o motor de regras compara com limiares e monta a sugestão
#     pronta. Custo zero por análise, resposta instantânea, funciona sem
#     nenhuma chave de API e sem internet.
#
#   ai — manda os MESMOS números agregados para o modelo configurado acima e
#     pede o texto de volta. Custa ~US$ 0,035 por análise. Vale se você quer
#     redação mais adaptada ao contexto de cada cliente.
SUGGESTION_ENGINE=rules
# SUGGESTION_ENGINE=ai

# Emissão fiscal (NF-e / NFC-e) — opcional. Sem nada configurado,
# FISCAL_PROVIDER cai em "stub": o fluxo inteiro funciona (emitir, cancelar,
# carta de correção, impressão), mas NÃO sai nota de verdade.
#
# Para emitir para valer com o Focus NFe:
#   1. Crie conta em focusnfe.com.br e cadastre a empresa (CNPJ, inscrição
#      estadual, endereço, regime tributário e certificado digital A1 ficam
#      no painel DELES, não aqui).
#   2. Pegue o token de API — são dois, um de homologação e um de produção.
#   3. Preencha abaixo. Deixe FOCUS_NFE_ENV=homologacao até validar tudo:
#      nota emitida em homologação não tem valor fiscal e não precisa ser
#      cancelada se der errado.
#   4. Cadastre NCM (e, se precisar, CFOP/CST) nos produtos — sem NCM a
#      emissão é barrada antes mesmo de chamar a SEFAZ, apontando o produto.
FISCAL_PROVIDER=stub
# FISCAL_PROVIDER=focusnfe
# FOCUS_NFE_TOKEN=
# FOCUS_NFE_ENV=homologacao   # troque para "producao" só quando for pra valer

# WhatsApp real (Fase E) — opcional. Sem nada configurado, WHATSAPP_PROVIDER
# cai em "stub" (só loga a mensagem, não envia nada de verdade). Pra ativar
# de verdade com o Sandbox gratuito do Twilio:
#   1. Crie uma conta em twilio.com e ative o Sandbox de WhatsApp
#      (Console → Messaging → Try it out → Send a WhatsApp message).
#   2. Exponha a API local publicamente (ex.: `ngrok http 3001`) e configure
#      a URL do ngrok + /api/whatsapp/webhook/twilio como webhook do Sandbox.
#   3. Preencha as variáveis abaixo e troque WHATSAPP_PROVIDER pra "twilio".
WHATSAPP_PROVIDER=stub
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# PUBLIC_API_URL=

# Teto de mensagens AUTOMÁTICAS por loja, por janela de 24h.
#
# Cada mensagem de WhatsApp é paga por unidade. Uma regra de automação com
# gatilho mal configurado envia sem ninguém no comando, e a primeira notícia
# disso costuma ser a fatura. Ao atingir o teto, os envios automáticos param e
# o motivo fica no log e no histórico da regra.
#
# A resposta do atendente no Inbox NÃO conta e nunca é bloqueada: lá tem uma
# pessoa clicando em enviar, uma de cada vez.
#
# 0 desliga o teto.
WHATSAPP_MAX_AUTOMATED_PER_DAY=300

# ---- E-mail ----
# Sem nada configurado, MAIL_PROVIDER cai em "stub": o fluxo inteiro funciona
# (inclusive "esqueci minha senha"), mas nada é enviado — a mensagem, com o
# link de redefinição, aparece no log da API. Em desenvolvimento isso basta.
#
# Para testar envio de verdade localmente, sem criar conta em lugar nenhum:
#   docker run -d --rm --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost, SMTP_PORT=1025, e abra http://localhost:8025
#
# Em produção, use o SMTP do seu provedor (Zoho, Amazon SES, Brevo, Gmail...).
# SMTP_SECURE é deduzido da porta quando omitido (465 = TLS direto; 587 = STARTTLS).
MAIL_PROVIDER=stub
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Minha Loja <nao-responda@minhaloja.com.br>

# URL usada para montar o link de redefinição de senha no e-mail. Em produção
# precisa ser o endereço público real — se ficar em localhost, o e-mail sai com
# um link que só funciona na máquina que hospeda.
WEB_APP_URL=http://localhost:3000

# ---- Web (apps/web — painel admin) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

