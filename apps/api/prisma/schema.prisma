generator client {
  provider = "prisma-client-js"

  // "native" cobre a máquina de desenvolvimento. O segundo alvo é a imagem
  // Docker (node:20-alpine): sem ele o Prisma gera o engine para musl com
  // OpenSSL 1.1, que o Alpine atual não tem mais, e o container sobe
  // normalmente para depois falhar na PRIMEIRA consulta ao banco com
  // "Error loading shared library libssl.so.1.1". Nenhum teste local pega
  // isso — só rodando a imagem.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Tenant: raiz do isolamento multi-tenant. Toda tabela de domínio de
// negócio (a partir da Fase 1) carrega tenantId e é filtrada
// automaticamente pelo middleware do Prisma (ver src/prisma).
// ------------------------------------------------------------------
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  document  String?      @unique // CNPJ
  status    TenantStatus @default(TRIAL)
  plan      String       @default("trial")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Personalização da loja virtual (Fase 8) — tudo opcional, o storefront
  // cai para os valores padrão (nome do tenant, sem logo/banner) quando
  // nada foi configurado ainda. Imagens são guardadas como data URI
  // (base64) direto no banco — não há storage de arquivos configurado
  // neste projeto, e o volume esperado (um logo/banner por tenant) não
  // justifica montar um bucket S3 só para isso.
  tagline        String?
  description    String?
  logoUrl        String?
  bannerUrl      String?
  logoPosition   String? // "50% 50%" — object-position CSS usado para enquadrar a logo/banner
  bannerPosition String? // dentro da área recortada, escolhido arrastando a imagem na tela de configurações
  primaryColor   String?

  // Contato da loja impresso no rodapé do cupom e da ordem de serviço. Um
  // comprovante sem telefone nem endereço não serve pro cliente voltar,
  // trocar ou reclamar — que é metade da razão de existir do papel.
  phone       String?
  addressLine String?

  // Taxas da maquininha de cartão de crédito por número de parcelas (1x-12x),
  // usadas para calcular automaticamente o repasse da taxa ao cliente na
  // hora da venda. Array de 12 números (percentual, ex.: 3.5) — índice 0 = 1x.
  // Null/posição vazia = sem repasse automático para aquele parcelamento.
  cardFeeRates Json?

  users     User[]
  modules   TenantModule[]
  auditLogs AuditLog[]

  customers        Customer[]
  suppliers        Supplier[]
  categories       Category[]
  warehouses       Warehouse[]
  products         Product[]
  sales            Sale[]
  financialEntries FinancialEntry[]
  coupons          Coupon[]
  invoices         Invoice[]

  conversations Conversation[]

  salesGoals            SalesGoal[]
  subscription          Subscription?
  quotes                Quote[]
  serviceOrders         ServiceOrder[]
  stockCounts           StockCount[]
  pipelineStages        PipelineStage[]
  opportunities         Opportunity[]
  aiConversations       AIConversation[]
  tasks                 Task[]
  automationRules       AutomationRule[]
  automationSuggestions AutomationSuggestion[]
  cashSessions          CashSession[]

  @@map("tenants")
}

// Habilita/desabilita módulos de negócio por tenant — base do futuro
// modelo de planos do SaaS (Fase 7).
model TenantModule {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey ModuleKey
  enabled   Boolean   @default(true)
  config    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String
  passwordHash     String
  role             UserRole  @default(ADMIN)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  commissionRate   Decimal?  @db.Decimal(5, 2) // percentual (0-100) sobre vendas confirmadas
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]
  salesAsSeller              Sale[]               @relation("SaleSeller")
  assignedConversations      Conversation[]       @relation("ConversationAgent")
  opportunitiesAsResponsible Opportunity[]
  aiConversations            AIConversation[]
  tasksAssigned              Task[]               @relation("TaskAssignee")
  tasksCreated               Task[]               @relation("TaskCreator")
  cashSessions               CashSession[]        @relation("CashSessionOperator")
  cashMovements              CashMovement[]       @relation("CashMovementUser")

  // email só precisa ser único dentro do tenant, não globalmente
  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de "esqueci minha senha". Guarda só o HASH do token, nunca o valor
/// enviado por e-mail — se o banco vazar, os links já emitidos continuam
/// inúteis. Mesmo princípio do RefreshToken acima.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// Fase 1 — Núcleo comercial: clientes, produtos, estoque, fornecedores.
// Todos os modelos abaixo carregam tenantId e estão em TENANT_SCOPED_MODELS
// (ver src/prisma/prisma.service.ts) para isolamento automático.
// ------------------------------------------------------------------

model Customer {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            CustomerType
  name            String
  document        String? // CPF ou CNPJ
  email           String?
  phone           String?
  segment         CustomerSegment @default(NEW)
  notes           String?
  isActive        Boolean         @default(true)
  // Cliente parceiro ("fiado"): quando preenchido, o vencimento das contas a
  // receber geradas por serviços/vendas desse cliente é adiado em N dias em
  // vez de vencer na hora (ver SalesService.createFromServiceOrder e
  // SalesService.create). Nulo = cliente comum, sem prazo especial.
  paymentTermDays Int?
  // Teto opcional do saldo em aberto (fiado) desse cliente — puramente
  // informativo hoje: o sistema mostra um aviso quando o saldo ultrapassa o
  // limite, mas não bloqueia a venda (decisão fica com quem está no balcão).
  creditLimit     Decimal?        @db.Decimal(12, 2)
  // Etiquetas livres do CRM (ex.: "VIP", "inadimplente") — array simples em
  // vez de um modelo Tag/CustomerTag relacional: não há pedido de gestão de
  // tags (cores, autocomplete) hoje, só exibição/filtro.
  tags            String[]        @default([])
  // Conta de acesso à loja virtual (Fase 3) — nula para clientes cadastrados
  // apenas via CRM interno, que nunca fizeram login na loja.

  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicles         CustomerVehicle[]
  addresses        CustomerAddress[]
  sales            Sale[]
  financialEntries FinancialEntry[]

  conversations Conversation[]
  quotes        Quote[]
  serviceOrders ServiceOrder[]
  opportunities Opportunity[]
  tasks         Task[]

  // document é opcional; múltiplos NULLs não conflitam em índice único no Postgres
  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@map("customers")
}

// Veículos do cliente (placa) — útil pra mecânica/loja de auto peças saber
// de cara qual carro o cliente tem, sem precisar perguntar toda vez.
model CustomerVehicle {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plate      String
  brand      String?
  model      String?
  color      String?
  year       Int?
  createdAt  DateTime @default(now())

  quotes        Quote[]
  serviceOrders ServiceOrder[]

  @@index([customerId])
  @@map("customer_vehicles")
}

// ------------------------------------------------------------------
// Orçamento (Fase 9) — proposta de peças/serviços enviada ao cliente por
// um link público (sem exigir login na loja). Quando aprovado, vira uma
// Ordem de Serviço automaticamente — ver QuotesService.approveByToken.
// ------------------------------------------------------------------
model Quote {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  vehicleId     String?
  vehicle       CustomerVehicle? @relation(fields: [vehicleId], references: [id])
  // Oportunidade de origem (opcional) — quando setado, a aprovação/recusa
  // deste orçamento move automaticamente a oportunidade para a etapa de
  // ganho/perda (ver QuotesService.approve/reject).
  opportunityId String?
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  description   String?
  status        QuoteStatus      @default(PENDING)
  // Único e não-sequencial de propósito: é a "senha" do link público —
  // não pode dar pra adivinhar o token de outro orçamento incrementando um id.
  publicToken   String           @unique @default(uuid())
  total         Decimal          @default(0) @db.Decimal(12, 2)
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items        QuoteItem[]
  serviceOrder ServiceOrder?

  @@index([tenantId, status])
  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  tenantId    String
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)

  @@index([quoteId])
  @@map("quote_items")
}

model ServiceOrder {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteId     String?            @unique
  quote       Quote?             @relation(fields: [quoteId], references: [id])
  saleId      String?            @unique
  sale        Sale?              @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  vehicleId   String?
  vehicle     CustomerVehicle?   @relation(fields: [vehicleId], references: [id])
  description String?
  status      ServiceOrderStatus @default(OPEN)
  total       Decimal            @default(0) @db.Decimal(12, 2)
  scheduledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  items ServiceOrderItem[]

  @@index([tenantId, status])
  @@index([customerId])
  @@index([scheduledAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id             String       @id @default(uuid())
  tenantId       String
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)

  @@index([serviceOrderId])
  @@map("service_order_items")
}

/// Endereços do cliente, cadastrados pela equipe no CRM (entrega, cobrança).
/// Não tem mais vínculo com venda: aquilo era o endereço de entrega do
/// checkout da loja virtual, removida.
model CustomerAddress {
  id           String      @id @default(uuid())
  tenantId     String
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         AddressType
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([customerId])
  @@map("customer_addresses")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productLinks     SupplierProduct[]
  financialEntries FinancialEntry[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("suppliers")
}

model Category {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now())

  @@index([tenantId, name])
  @@map("categories")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockItems  StockItem[]
  movements   StockMovement[]
  sales       Sale[]
  stockCounts StockCount[]

  @@index([tenantId])
  @@map("warehouses")
}

model Product {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                String
  barcode            String?
  name               String
  description        String?
  brand              String?
  vehicleApplication String? // texto livre: ex. "Gol G5/G6 1.0/1.6 2008-2014"
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit               String    @default("UN")
  costPrice          Decimal   @default(0) @db.Decimal(12, 2)
  price              Decimal   @default(0) @db.Decimal(12, 2)
  weightKg           Decimal   @default(0.5) @db.Decimal(8, 3) // usado no cálculo de frete
  minStock           Int       @default(0)

  // ---- Dados fiscais (exigidos pela SEFAZ em cada item da nota) ----
  // Opcionais no banco de propósito: quem não emite nota nunca preenche isso,
  // e obrigar no cadastro travaria o uso do sistema para a maioria. Quem VAI
  // emitir é avisado do que falta na hora da emissão (ver InvoicesService),
  // que é quando a informação realmente importa.
  /// Nomenclatura Comum do Mercosul — 8 dígitos, define a tributação do item.
  ncm        String?
  /// Código Fiscal de Operações — 4 dígitos (ex.: 5102 = venda dentro do estado).
  cfop       String?
  /// Origem da mercadoria: 0 = nacional, 1 = importação direta, 2 = mercado interno…
  icmsOrigem String?  @default("0")
  /// CST (regime normal) ou CSOSN (Simples Nacional) do ICMS.
  icmsCst    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockItems           StockItem[]
  movements            StockMovement[]
  supplierLinks        SupplierProduct[]
  saleItems            SaleItem[]
  quoteItems           QuoteItem[]
  serviceOrderItems    ServiceOrderItem[]
  stockCountItems      StockCountItem[]
  // peças equivalentes/similares são uma relação simétrica, mas guardamos só
  // um sentido por par (ver ProductsService) e consultamos os dois lados ao
  // listar — evita duplicar a mesma ligação nos dois sentidos no banco.
  equivalencesAsSource ProductEquivalence[] @relation("ProductEquivalenceSource")
  equivalencesAsTarget ProductEquivalence[] @relation("ProductEquivalenceTarget")

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

model ProductEquivalence {
  id           String   @id @default(uuid())
  tenantId     String
  productId    String
  product      Product  @relation("ProductEquivalenceSource", fields: [productId], references: [id], onDelete: Cascade)
  equivalentId String
  equivalent   Product  @relation("ProductEquivalenceTarget", fields: [equivalentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([productId, equivalentId])
  @@index([productId])
  @@index([equivalentId])
  @@map("product_equivalences")
}

model StockItem {
  id          String    @id @default(uuid())
  tenantId    String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@map("stock_items")
}

model StockMovement {
  id               String            @id @default(uuid())
  tenantId         String
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type             StockMovementType
  quantity         Int // sempre positivo; o efeito depende do type (ver StockService)
  previousQuantity Int
  newQuantity      Int
  reason           String?
  userId           String?
  createdAt        DateTime          @default(now())

  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

enum StockCountStatus {
  OPEN
  COMPLETED
  CANCELED
}

model StockCount {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status      StockCountStatus @default(OPEN)
  notes       String?
  userId      String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  items StockCountItem[]

  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id           String     @id @default(uuid())
  tenantId     String
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  // quantidade que o sistema tinha registrada no momento em que a contagem
  // foi aberta (snapshot — não muda mesmo que o estoque real mude depois)
  expectedQty  Int
  // null enquanto ninguém contou esse item ainda
  countedQty   Int?

  @@unique([stockCountId, productId])
  @@index([stockCountId])
  @@map("stock_count_items")
}

model SupplierProduct {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku String?
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  isPreferred Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([supplierId, productId])
  @@index([tenantId])
  @@map("supplier_products")
}

// ------------------------------------------------------------------
// Fase 2 — Vendas (PDV) e financeiro.
// ------------------------------------------------------------------

model Sale {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId    String?
  seller      User?      @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status      SaleStatus @default(QUOTE)

  couponId      String?
  coupon        Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  subtotal      Decimal      @default(0) @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  shippingCost  Decimal      @default(0) @db.Decimal(12, 2)
  // Acréscimo de repasse da taxa da maquininha de cartão de crédito, somado
  // ao total quando a venda inclui pagamento em cartão de crédito com
  // repasse habilitado (ver Tenant.cardFeeRates).
  cardFeeAmount Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @default(0) @db.Decimal(12, 2)
  notes         String?
  // Caixa em que a venda foi confirmada. Opcional porque nem toda venda passa
  // pelo balcão: pedido da loja virtual e venda gerada por ordem de serviço
  // não têm operador com gaveta aberta. Só as que têm entram na conferência
  // de fechamento.
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items            SaleItem[]
  payments         SalePayment[]
  financialEntries FinancialEntry[]
  invoice          Invoice?

  serviceOrder ServiceOrder?

  @@index([tenantId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Preenchido só quando não há produto (ex.: mão de obra vinda de uma
  // ordem de serviço) — item com produto usa product.name na exibição.
  description String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

model SalePayment {
  id           String        @id @default(uuid())
  tenantId     String
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  installments Int           @default(1)
  amount       Decimal       @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

// Lançamento financeiro unificado: pagável (fornecedor/despesa) ou
// recebível (cliente/venda). O tipo distingue o sentido do fluxo de caixa.
model FinancialEntry {
  id             String               @id @default(uuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           FinancialEntryType
  description    String
  category       String?
  amount         Decimal              @db.Decimal(12, 2)
  dueDate        DateTime
  paidAt         DateTime?
  status         FinancialEntryStatus @default(PENDING)
  customerId     String?
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId         String?
  sale           Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  // Preenchido pela automação de cobrança (Fase 5) para não reenviar o
  // mesmo lembrete de cobrança a cada execução do job diário.
  reminderSentAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId, type, status, dueDate])
  @@map("financial_entries")
}

// ------------------------------------------------------------------
// Fase 3 — E-commerce: loja virtual, checkout, cupons, avaliações.
// ------------------------------------------------------------------

model Coupon {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  discountType  CouponDiscountType
  value         Decimal            @db.Decimal(12, 2) // percentual (0-100) ou valor fixo em R$, conforme discountType
  freeShipping  Boolean            @default(false)
  minOrderValue Decimal?           @db.Decimal(12, 2)
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int?
  usedCount     Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  sales Sale[]

  @@unique([tenantId, code])
  @@map("coupons")
}

// ------------------------------------------------------------------
// Fase 4 — Fiscal e logística.
//
// Invoice: emissão de NF-e/NFC-e é simulada (ver FiscalProviderService) —
// não há integração real com SEFAZ/Focus NFe nesta fase. O modelo e o fluxo
// de status já são os reais; trocar a implementação do provider por uma
// chamada HTTP de verdade não exige mudar nada aqui.
//
// Shipment: rastreamento por atualização manual da equipe (código de
// rastreio + status), o jeito como a maioria dos pequenos comércios opera
// antes de integrar a API de uma transportadora.
// ------------------------------------------------------------------

model Invoice {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId     String        @unique
  sale       Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type       InvoiceType
  status     InvoiceStatus @default(PENDING)
  accessKey  String? // chave de acesso de 44 dígitos
  series     String?
  number     String?
  xmlContent String? // usado pelo provedor simulado, que não tem URL para apontar

  /// Referência única desta nota no NOSSO sistema, enviada ao provedor como
  /// chave de idempotência. Sem ela, uma repetição da requisição (timeout,
  /// clique duplo) emitiria uma segunda nota para a mesma venda — erro caro
  /// e trabalhoso de desfazer.
  externalRef  String?
  /// URLs devolvidas pelo provedor real: o PDF que se entrega ao cliente e o
  /// XML que se guarda por cinco anos.
  danfeUrl     String?
  xmlUrl       String?
  /// Retorno da SEFAZ — é o que explica uma rejeição para quem está no balcão.
  sefazStatus  String?
  sefazMessage String?
  protocol     String?

  cancelReason String?
  issuedAt     DateTime?
  canceledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  corrections InvoiceCorrection[]

  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceCorrection {
  id        String   @id @default(uuid())
  tenantId  String
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_corrections")
}

// ------------------------------------------------------------------
// Fase 5 — WhatsApp e automação: inbox de conversas, chatbot e
// mensagens automáticas (confirmação, rastreio, cobrança, carrinho
// abandonado). O envio real usa um provedor plugável (ver
// src/whatsapp/whatsapp-provider.interface.ts) — nesta fase, simulado.
// ------------------------------------------------------------------

model Conversation {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber    String
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         ConversationStatus @default(OPEN)
  assignedUserId String?
  assignedUser   User?              @relation("ConversationAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages Message[]

  // Uma conversa por número de telefone por tenant — mensagens novas do
  // mesmo número entram na mesma thread em vez de abrir outra.
  @@unique([tenantId, phoneNumber])
  @@index([tenantId, status])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  tenantId       String
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  sender         MessageSender
  content        String
  automationType AutomationType?
  externalId     String?
  status         MessageStatus    @default(SENT)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Cópia mínima do carrinho do storefront (que vive no localStorage do
// navegador) usada só para detectar abandono e disparar o lembrete por
// WhatsApp — não é a fonte de verdade do carrinho, que continua no cliente.

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AutomationType {
  ORDER_CONFIRMATION
  SHIPPING_UPDATE
  PAYMENT_REMINDER
  ABANDONED_CART
}

// ------------------------------------------------------------------
// Fase 6 — Relatórios e BI: meta de vendas mensal, usada no dashboard
// gerencial para comparar realizado x meta.
// ------------------------------------------------------------------
model SalesGoal {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month        String // formato 'YYYY-MM'
  targetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, month])
  @@map("sales_goals")
}

// ------------------------------------------------------------------
// Fase 7 — Preparação para SaaS: planos, assinatura e cobrança recorrente
// dos TENANTS (diferente de FinancialEntry, que é o financeiro do próprio
// tenant sobre os clientes DELE). Por isso estes models são dados de
// PLATAFORMA — de propósito NÃO entram em TENANT_SCOPED_MODELS, pois o
// painel de super-admin precisa enxergar todos os tenants de uma vez.
// ------------------------------------------------------------------

model Plan {
  id           String      @id @default(uuid())
  key          String      @unique // 'trial' | 'pro' | 'premium'
  name         String
  priceMonthly Decimal     @db.Decimal(12, 2)
  modules      ModuleKey[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid())
  subscriptionId String
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId       String // denormalizado — evita join para o painel de super-admin listar faturas de todos os tenants
  amount         Decimal                   @db.Decimal(12, 2)
  status         SubscriptionInvoiceStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  externalId     String?
  createdAt      DateTime                  @default(now())

  @@index([tenantId])
  @@map("subscription_invoices")
}

// ------------------------------------------------------------------
// Fase 9 — CRM: funil de vendas (oportunidades + pipeline). Extensão sobre
// o fluxo já existente de Orçamento→Ordem de Serviço→Venda: a oportunidade
// é opcionalmente vinculada a um Quote (Quote.opportunityId) e avança
// automaticamente para a etapa de ganho/perda quando o orçamento vinculado
// é aprovado/recusado (ver QuotesService.approve/reject).
//
// Sem um modelo Pipeline separado de propósito: um funil implícito por
// tenant (as PipelineStage do tenant, ordenadas por `order`) é suficiente —
// nada no produto hoje pede múltiplos funis nomeados por tenant.
// ------------------------------------------------------------------

model PipelineStage {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  isWonStage  Boolean  @default(false)
  isLostStage Boolean  @default(false)
  createdAt   DateTime @default(now())

  opportunities Opportunity[]

  @@unique([tenantId, order])
  @@map("pipeline_stages")
}

model Opportunity {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  title          String
  estimatedValue Decimal?          @db.Decimal(12, 2)
  status         OpportunityStatus @default(OPEN)
  responsibleId  String?
  responsible    User?             @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  source         String?
  tags           String[]          @default([])
  lostReason     String?
  wonAt          DateTime?
  lostAt         DateTime?
  // Quando a etapa muda, este campo é atualizado junto — é o que permite
  // calcular "tempo na etapa" e detectar oportunidades paradas (dashboard).
  stageChangedAt DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  quotes Quote[]
  tasks  Task[]

  @@index([tenantId, stageId])
  @@index([tenantId, status])
  @@map("opportunities")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// ------------------------------------------------------------------
// Fase 10 — ComerciON IA: assistente interno de function-calling. Cada
// conversa é pessoal (por usuário) e cada tool que a IA chama já roda
// escopada pelo tenant, via o mesmo middleware que protege o resto do
// sistema — nenhuma tool recebe tenantId explícito.
// ------------------------------------------------------------------

model AIConversation {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([tenantId, userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  tenantId       String
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String         @db.Text
  // Preenchido só quando role=TOOL — qual function rodou, pra exibir/depurar.
  toolName       String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AIMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  FAILED
}

// ------------------------------------------------------------------
// Fase 11 — Tarefas/Follow-up: lembretes internos da equipe (não confundir
// com as automações de WhatsApp, que falam com o cliente final). Vínculo
// com Customer/Opportunity é opcional — uma tarefa pode ser avulsa.
// ------------------------------------------------------------------

model Task {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?      @db.Text
  dueDate       DateTime?
  status        TaskStatus   @default(PENDING)
  completedAt   DateTime?
  assignedToId  String
  assignedTo    User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User         @relation("TaskCreator", fields: [createdById], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, assignedToId, status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, opportunityId])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  DONE
  CANCELED
}

// ------------------------------------------------------------------
// Fase 12 — Automações genéricas: catálogo fixo de gatilhos/ações (não é um
// motor de condições livres). AutomationRunLog é a idempotência genérica,
// diferente do padrão de coluna xSentAt usado nas automações fixas de
// WhatsApp (não escala pra regras configuráveis).
//
// Fase F — a idempotência deixou de ser absoluta: antes havia um
// @@unique([ruleId, entityType, entityId]) que impedia uma regra de disparar
// duas vezes no mesmo registro *para sempre*, o que tornava impossível
// "cobrar de novo a cada 7 dias". Virou índice comum + AutomationRule
// .cooldownDays, verificado pelo motor contra o firedAt mais recente.
// ------------------------------------------------------------------

model AutomationRule {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  trigger       AutomationTrigger
  triggerConfig Json?
  action        AutomationAction
  actionConfig  Json
  // Reenvio controlado: null = dispara uma única vez por registro (o
  // comportamento original, e o padrão seguro contra encher o cliente de
  // mensagem). N = pode disparar de novo no mesmo registro após N dias.
  cooldownDays  Int?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  runs        AutomationRunLog[]
  suggestions AutomationSuggestion[]

  @@index([tenantId, trigger, isActive])
  @@map("automation_rules")
}

model AutomationRunLog {
  id         String               @id @default(uuid())
  tenantId   String
  ruleId     String
  rule       AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType AutomationEntityType
  entityId   String
  firedAt    DateTime             @default(now())
  success    Boolean              @default(true)
  error      String?

  // Ordem pensada pra consulta do motor: "qual o disparo mais recente desta
  // regra neste registro?" — substitui o antigo NOT IN com a lista inteira
  // de ids já disparados, que crescia sem limite.
  @@index([ruleId, entityType, entityId, firedAt])
  @@index([tenantId, firedAt])
  @@map("automation_run_logs")
}

// Sugestões de automação geradas pela IA a partir dos dados reais do tenant.
// Persistidas (e não recalculadas a cada abertura da tela) porque cada
// geração é uma chamada paga ao modelo: o recálculo é agendado/sob demanda,
// a leitura é sempre do cache. `status` também evita re-sugerir o que o
// usuário já descartou.
model AutomationSuggestion {
  id            String                     @id @default(uuid())
  tenantId      String
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  // O dado concreto que motivou a sugestão (ex.: "12 orçamentos parados há
  // mais de 5 dias, somando R$ 8.400") — é o que o usuário lê pra decidir.
  rationale     String
  trigger       AutomationTrigger
  triggerConfig Json?
  action        AutomationAction
  actionConfig  Json
  status        AutomationSuggestionStatus @default(PENDING)
  // Regra criada quando a sugestão é aceita — mantém o rastro de qual
  // automação nasceu de qual sugestão.
  createdRuleId String?
  createdRule   AutomationRule?            @relation(fields: [createdRuleId], references: [id], onDelete: SetNull)
  generatedAt   DateTime                   @default(now())

  @@index([tenantId, status])
  @@map("automation_suggestions")
}

enum AutomationSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum AutomationTrigger {
  QUOTE_PENDING_DAYS
  OPPORTUNITY_STALE_DAYS
  SALE_CONFIRMED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  CUSTOMER_INACTIVE_DAYS
  LOW_STOCK
  RECEIVABLE_OVERDUE_DAYS
  SERVICE_ORDER_STALE_DAYS
}

enum AutomationAction {
  SEND_WHATSAPP
  CREATE_TASK
}

enum AutomationEntityType {
  QUOTE
  OPPORTUNITY
  SALE
  CUSTOMER
  PRODUCT
  FINANCIAL_ENTRY
  SERVICE_ORDER
}

enum InvoiceType {
  NFE
  NFCE
}

enum InvoiceStatus {
  PENDING
  ISSUED
  CANCELED
  ERROR
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// ------------------------------------------------------------------
// Caixa (frente de loja) — abertura, sangria/suprimento e fechamento com
// conferência da gaveta.
//
// A sessão é POR OPERADOR, não por loja: numa loja de um caixa só, uma pessoa
// abre e fecha; numa de dois balcões, cada operador tem a sua; e na troca de
// turno um fecha e o outro abre, cada um respondendo pelo próprio dinheiro.
// Isso evita precisar de um cadastro de "terminal/PDV" só para isso.
// ------------------------------------------------------------------

model CashSession {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operatorId String
  operator   User              @relation("CashSessionOperator", fields: [operatorId], references: [id])
  status     CashSessionStatus @default(OPEN)

  /// Troco deixado na gaveta na abertura.
  openingAmount Decimal  @db.Decimal(12, 2)
  openedAt      DateTime @default(now())

  /// Preenchidos no fechamento. `countedAmount` é o que a pessoa contou de
  /// verdade; `expectedAmount` é o que o sistema calculou; `difference` é
  /// contado − esperado (negativo = falta dinheiro). Guardamos os três, e não
  /// só a diferença, porque numa conferência o histórico do que foi declarado
  /// vale tanto quanto o resultado.
  countedAmount  Decimal?  @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  closingNotes   String?
  closedAt       DateTime?

  movements CashMovement[]
  sales     Sale[]

  /// Índice pensado na consulta mais frequente: "este operador tem caixa aberto?"
  @@index([tenantId, operatorId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id        String           @id @default(uuid())
  tenantId  String
  sessionId String
  session   CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  /// Obrigatório de propósito: sangria sem motivo declarado é exatamente o
  /// tipo de lançamento que ninguém consegue explicar no fim do mês.
  reason    String
  userId    String
  user      User             @relation("CashMovementUser", fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
  @@map("cash_movements")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  /// Sangria: retirada de dinheiro da gaveta (levar ao cofre, pagar entrega).
  WITHDRAWAL
  /// Suprimento: reforço de troco colocado na gaveta.
  DEPOSIT
}

enum SaleStatus {
  QUOTE
  CONFIRMED
  CANCELED
  RETURNED
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BOLETO
}

enum FinancialEntryType {
  PAYABLE
  RECEIVABLE
}

enum FinancialEntryStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerSegment {
  NEW
  RECURRING
  VIP
  DELINQUENT
}

enum AddressType {
  SHIPPING
  BILLING
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  LOSS
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

// Catálogo de módulos de negócio ativáveis por tenant (cresce nas próximas fases)
enum ModuleKey {
  CRM
  INVENTORY
  SUPPLIERS
  SALES
  FINANCE
  ECOMMERCE
  FISCAL
  LOGISTICS
  WHATSAPP
  MARKETING
  BI
  AI
  AUTOMATIONS
}

