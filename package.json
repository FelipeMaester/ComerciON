{
  "name": "comercion",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:e2e": "pnpm --filter e2e test",
    "test:e2e:ui": "pnpm --filter e2e test:ui"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18",
      "js-yaml": ">=4.3.1",
      "picomatch": ">=4.0.4",
      "tmp": ">=0.2.6",
      "glob": ">=10.5.0",
      "lodash": ">=4.18.0"
    }
  }
}
